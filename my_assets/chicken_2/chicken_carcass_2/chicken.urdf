<?xml version="1.0"?>
<robot name="chicken_carcass">

  <!-- Torso: ~1.2 kg, elongated body shape (longer in y, flatter in z) -->
  <link name="torso">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/torso.obj" scale="1 1 1"/></geometry>
      <material name="chicken_color">
        <color rgba="0.95 0.85 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/torso.obj" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <!-- Elongated body: ~0.15m long x 0.10m wide x 0.08m tall at 0.25 scale -->
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- Left wing: ~0.15 kg, flat thin surface rotating around z-axis -->
  <link name="left_wing">
    <visual>
      <origin xyz="-0.2434 -0.2278 0.0387" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/left_wing.obj" scale="1 1 1"/></geometry>
      <material name="chicken_color"/>
    </visual>
    <collision>
      <origin xyz="-0.2434 -0.2278 0.0387" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/left_wing.obj" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <!-- Flat wing: larger inertia in x-y plane, small around z (rotation axis) -->
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- Left shoulder: rotates around z. Low damping so wing droops naturally. -->
  <joint name="left_shoulder" type="revolute">
    <parent link="torso"/>
    <child link="left_wing"/>
    <origin xyz="0.2434 0.2278 -0.0387" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- Right wing: ~0.15 kg, same as left -->
  <link name="right_wing">
    <visual>
      <origin xyz="0.2708 -0.1901 0.0298" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/right_wing.obj" scale="1 1 1"/></geometry>
      <material name="chicken_color"/>
    </visual>
    <collision>
      <origin xyz="0.2708 -0.1901 0.0298" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/right_wing.obj" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="right_shoulder" type="revolute">
    <parent link="torso"/>
    <child link="right_wing"/>
    <origin xyz="-0.2708 0.1901 -0.0298" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- Left leg: ~0.25 kg, thin rod rotating around x-axis -->
  <link name="left_leg">
    <visual>
      <origin xyz="-0.1457 0.3212 -0.0219" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/left_leg.obj" scale="1 1 1"/></geometry>
      <material name="chicken_color"/>
    </visual>
    <collision>
      <origin xyz="-0.1457 0.3212 -0.0219" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/left_leg.obj" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <!-- Thin rod: small inertia around x (rotation axis), larger in y-z -->
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <!-- Left hip: rotates around x. Low damping so leg swings and droops naturally. -->
  <joint name="left_hip" type="revolute">
    <parent link="torso"/>
    <child link="left_leg"/>
    <origin xyz="0.1457 -0.3212 0.0219" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- Right leg: ~0.25 kg, same as left -->
  <link name="right_leg">
    <visual>
      <origin xyz="0.1308 0.3112 -0.0446" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/right_leg.obj" scale="1 1 1"/></geometry>
      <material name="chicken_color"/>
    </visual>
    <collision>
      <origin xyz="0.1308 0.3112 -0.0446" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/right_leg.obj" scale="1 1 1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <joint name="right_hip" type="revolute">
    <parent link="torso"/>
    <child link="right_leg"/>
    <origin xyz="-0.1308 -0.3112 0.0446" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

</robot>
